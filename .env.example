# Copy this file to .env and fill in your secrets.
# .env is ignored by git.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_TEMPERATURE=0.0
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
SYNAPSE_AUTO_BACKFILL_EMBEDDINGS=true
SYNAPSE_EXPLORER_MODE=epistemic_tools
SYNAPSE_EPISTEMIC_LAMBDA_COST=0.15
SYNAPSE_EPISTEMIC_MU_RISK=0.10
SYNAPSE_EPISTEMIC_STOP_ENTROPY=0.35
SYNAPSE_EPISTEMIC_COST_BUDGET=0.28
SYNAPSE_EPISTEMIC_RISK_BUDGET=0.12
SYNAPSE_EPISTEMIC_DUAL_STEP=0.08
SYNAPSE_MEMORY_DIR=.synapse_memory
